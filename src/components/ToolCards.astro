---
// The three trek tools as cards (start page, /tools/ and "More trek tools" on each tool page).
interface Props { exclude?: string }
const { exclude } = Astro.props;
const TOOLS = [
  { slug: 'elevation-profile', title: 'Elevation profile', text: 'Day by day: altitude gain, sleep height and rest days.' },
  { slug: 'cost-calculator', title: 'Trek cost calculator', text: 'Add up permits, flights, lodges, guide and porter.' },
  { slug: 'acclimatization-planner', title: 'Acclimatization planner', text: 'Build your own itinerary and check the pace.' },
].filter((t) => t.slug !== exclude);
---
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px">
  {TOOLS.map((t) => (
    <a class="card" href={`/tools/${t.slug}/`} style="display: flex; flex-direction: column; gap: 12px; padding: 24px; border-color: rgba(15,36,48,0.10)">
      {t.slug === 'elevation-profile' && <svg width="120" height="44" viewBox="0 0 120 44" aria-hidden="true" fill="none" stroke="#C2410C" stroke-width="2" stroke-linejoin="round"><path d="M2 38 L18 41 L32 30 L46 30 L60 25 L74 18 L88 18 L102 11 L118 4"/></svg>}
      {t.slug === 'cost-calculator' && <svg width="120" height="44" viewBox="0 0 120 44" aria-hidden="true" fill="none" stroke="#C2410C" stroke-width="2"><rect x="2" y="24" width="18" height="18"/><rect x="28" y="14" width="18" height="28"/><rect x="54" y="6" width="18" height="36"/><path d="M82 22 H118 M100 4 V40"/></svg>}
      {t.slug === 'acclimatization-planner' && <svg width="120" height="44" viewBox="0 0 120 44" aria-hidden="true" fill="none" stroke="#C2410C" stroke-width="2"><rect x="2" y="4" width="116" height="36" rx="4"/><path d="M2 16 H118 M30 4 V40 M58 4 V40 M86 4 V40"/></svg>}
      <span style="font-family: var(--sans); font-weight: 800; font-size: 21px">{t.title}</span>
      <span style="font-size: 16px; color: var(--muted); line-height: 1.5">{t.text}</span>
    </a>
  ))}
</div>
