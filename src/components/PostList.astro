---
// Post list as photo cards with a short summary (archives, author page, start page).
// Covers are at most 620 px wide, so the srcset stops there; `priority` loads the first cards eagerly (LCP on archives).
import { Image } from 'astro:assets';
import { postMeta, postExcerpt, type Post } from '../lib/site';
interface Props { posts: Post[]; priority?: number }
const { posts, priority = 0 } = Astro.props;
---
<div class="pl">
  {posts.map((p, i) => (
    <a class="pl-item" href={`/${p.id}/`}>
      {p.data.cover && (
        <Image class="pl-img" src={p.data.cover} alt="" width={620} height={349} fit="cover" quality={70} widths={[460, 620]}
          sizes="(min-width: 1000px) 456px, (min-width: 700px) 50vw, 100vw"
          loading={i < priority ? 'eager' : 'lazy'} fetchpriority={i === 0 && priority > 0 ? 'high' : undefined} decoding="async" />
      )}
      <span class="pl-text">
        <span class="pl-title">{p.data.title}</span>
        <span class="pl-ex">{postExcerpt(p)}</span>
        <span class="meta">{postMeta(p)}</span>
      </span>
    </a>
  ))}
</div>
<style>
  .pl { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; margin-top: 16px; }
  .pl-item { display: flex; flex-direction: column; background: var(--paper); border: 1px solid var(--line); border-radius: 8px; overflow: hidden; color: var(--ink); }
  .pl-item:hover { border-color: var(--ink); }
  .pl-item:hover .pl-title { color: var(--accent); }
  .pl-img { display: block; width: 100%; height: auto; aspect-ratio: 620 / 349; object-fit: cover; background: var(--line-soft); }
  .pl-text { display: flex; flex-direction: column; gap: 6px; padding: 18px 20px 22px; }
  .pl-title { font-family: var(--sans); font-weight: 700; font-size: 20px; line-height: 1.3; }
  .pl-ex { font-family: var(--serif); font-size: 16px; line-height: 1.5; color: var(--muted); display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; }
  .pl-text .meta { margin-top: 2px; }
  @media (max-width: 699px) { .pl { grid-template-columns: minmax(0, 1fr); gap: 20px; } .pl-title { font-size: 19px; } }
</style>
