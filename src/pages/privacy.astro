---
import Base from '../layouts/Base.astro';
import { SITE_NAME } from '../lib/site';
---
<Base title={`Privacy | ${SITE_NAME}`} noindex>
  <div class="wrap prose" style="padding-top: 56px; padding-bottom: 96px; max-width: 760px">
    <h1 class="h-display" style="font-size: 44px; margin-bottom: 24px">Privacy</h1>
    <p><strong>[DRAFT — to be reviewed before launch.]</strong></p>
    <p>This site is hosted on Cloudflare. If you agree in the cookie banner, we use Google Analytics to count visits and Google AdSense to show ads. If you reject, neither sets cookies. You can change your choice at any time with “Cookie settings” in the footer.</p>
    <p>Contact: [EMAIL]</p>
  </div>
</Base>
