---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from './Base.astro';
import Notice from '../components/Notice.astro';
import ElevationMini from '../components/ElevationMini.astro';
import { HUB_INFO, fmtDay, readingMinutes, type Post } from '../lib/site';
import { articleLd } from '../lib/ld';

interface Props { post: Post; prev?: Post; next?: Post; related: Post[] }
const { post, prev, next, related } = Astro.props;
const d = post.data;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const hub = HUB_INFO[d.hub];
const mark = /lukla/.test(post.id) ? 'lukla' : undefined;
---
<Base title={d.title} description={d.description} ogType="article" image={d.cover} published={d.pubDate} modified={d.updatedDate} activeHub={d.hub} jsonLd={articleLd(post, Astro.site!)}>
  <div class="wrap" style="padding-top: 40px">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span><a href={`/${d.hub}/`}>{hub.nav}</a><span aria-hidden="true">/</span><span>{d.title}</span>
    </nav>
    <div style="max-width: 860px; margin-top: 28px">
      <div class="kicker">{hub.title}</div>
      <h1 class="h-display" data-pagefind-meta="title" style="margin: 14px 0 18px; font-size: clamp(36px, 4.6vw, 54px)">{d.title}</h1>
      <div class="meta" style="display: flex; flex-wrap: wrap; gap: 6px 20px">
        <span>By <a href="/author/alberts/" style="text-decoration: underline">Alberts</a></span>
        <span>Written <time datetime={d.pubDate.toISOString().slice(0, 10)}>{fmtDay(d.pubDate)}</time></span>
        <span>{readingMinutes(post.body)} min read</span>
      </div>
    </div>
    {d.notice !== 'none' && <div style="margin-top: 28px; max-width: 860px"><Notice kind={d.notice} year={d.pubDate.getUTCFullYear()} /></div>}
  </div>

  <div class="wrap" style="padding-top: 36px; padding-bottom: 80px; display: flex; flex-wrap: wrap; gap: 64px; align-items: flex-start">
    <article style="flex: 999 1 560px; min-width: 0; max-width: 720px">
      {d.cover && (
        <figure style="margin: 0 0 36px">
          <Image src={d.cover} alt="" widths={[720, 1440]} sizes="(min-width: 800px) 720px, 100vw" loading="eager" fetchpriority="high" style="display: block; width: 100%; height: auto; border-radius: 6px" />
        </figure>
      )}
      <div class="prose" data-pagefind-body><Content /></div>

      <div class="card" style="margin-top: 48px; padding: 24px; display: flex; gap: 18px; align-items: flex-start; font-family: var(--sans); line-height: 1.5">
        <div aria-hidden="true" style="flex: none; width: 56px; height: 56px; border-radius: 28px; background: var(--ink); color: #FFFFFF; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 22px">A</div>
        <div>
          <a href="/author/alberts/" style="font-weight: 800; font-size: 18px">Alberts</a>
          <p style="margin: 4px 0 0; font-size: 15px; color: var(--muted)">[Short bio: your treks in the Khumbu — years, routes, what you saw first-hand.]</p>
        </div>
      </div>
      <nav aria-label="More articles" style="margin-top: 24px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; font-family: var(--sans); line-height: 1.35">
        {prev ? <a class="card" href={`/${prev.id}/`} style="padding: 18px 20px"><span class="meta" style="display: block">← Previous</span><span style="font-weight: 700; font-size: 17px">{prev.data.title}</span></a> : <span />}
        {next && <a class="card" href={`/${next.id}/`} style="padding: 18px 20px; text-align: right"><span class="meta" style="display: block">Next →</span><span style="font-weight: 700; font-size: 17px">{next.data.title}</span></a>}
      </nav>
    </article>

    <aside style="flex: 1 1 300px; min-width: 0; display: flex; flex-direction: column; gap: 20px; font-family: var(--sans); line-height: 1.45">
      {toc.length >= 3 && (
        <nav class="card" aria-label="On this page" style="padding: 22px">
          <div style="font-size: 14px; font-weight: 600; color: var(--muted); margin-bottom: 12px">On this page</div>
          <ol style="margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; font-size: 15px; font-weight: 600">
            {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
          </ol>
        </nav>
      )}
      <ElevationMini mark={mark} />
      {related.length > 0 && (
        <div class="card" style="padding: 22px">
          <div style="font-size: 14px; font-weight: 600; color: var(--muted); margin-bottom: 12px">Related</div>
          <div style="display: flex; flex-direction: column; gap: 12px; font-size: 16px; font-weight: 700">
            {related.map((r) => <a href={`/${r.id}/`}>{r.data.title}</a>)}
          </div>
        </div>
      )}
    </aside>
  </div>
</Base>
