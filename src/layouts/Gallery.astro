---
import { Image } from 'astro:assets';
import Base from './Base.astro';
import ElevationMini from '../components/ElevationMini.astro';
import { HUB_INFO, fmtMonth, imageCount, allPosts, type Post } from '../lib/site';
import { parseGallery, inline } from '../lib/gallery';
import { articleLd } from '../lib/ld';

interface Props { post: Post }
const { post } = Astro.props;
const d = post.data;
const { intro, shots, closing } = parseGallery(post.id, post.body);
const n = imageCount(post.body);
const camera = closing.some((c) => /Hasselblad/.test(c)) ? 'Hasselblad 500C/M' : undefined;
const mark = /kala-patthar/.test(post.id) ? 'kalapatthar' : undefined;
const others = (await allPosts()).filter((p) => p.data.layout === 'gallery' && p.id !== post.id);
const thumbs = others.map((p) => ({ p, first: parseGallery(p.id, p.body).shots.find((s) => s.images.length)?.images[0] }));
---
<Base title={d.title} description={d.description} ogType="article" image={d.cover} activeHub={d.hub} jsonLd={articleLd(post, Astro.site!)}>
  <div class="wrap" style="padding-top: 40px">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span><a href={`/${d.hub}/`}>{HUB_INFO[d.hub].nav}</a><span aria-hidden="true">/</span><span>{d.title}</span>
    </nav>
    <div style="display: flex; flex-wrap: wrap; gap: 32px 64px; align-items: flex-end; margin-top: 28px; padding-bottom: 40px; border-bottom: 1px solid var(--line)">
      <div style="flex: 999 1 560px; min-width: 0">
        <div class="kicker">{HUB_INFO[d.hub].title}</div>
        <h1 class="h-display" data-pagefind-meta="title" style="margin: 12px 0 18px; font-size: clamp(38px, 5vw, 60px)">{d.title}</h1>
        <div class="meta" style="display: flex; flex-wrap: wrap; gap: 6px 22px">
          <span>By <a href="/author/alberts/" style="text-decoration: underline">Alberts</a></span>
          <time datetime={d.pubDate.toISOString().slice(0, 10)}>{fmtMonth(d.pubDate)}</time>
          <span>{n} photos</span>
          {camera && <span>{camera}</span>}
        </div>
        {intro.map((p) => <p style="margin: 18px 0 0; max-width: 720px" set:html={inline(p)} />)}
      </div>
      {mark && <div style="flex: 1 1 320px; min-width: 0"><ElevationMini mark={mark} label="Where these were taken" /></div>}
    </div>
  </div>

  <main class="wrap" data-pagefind-body>
    {shots.map((s, i) => {
      const wide = s.images.some((im) => im.src.width / im.src.height > 1.6);
      return (
        <section style={`display: flex; flex-direction: ${i % 2 && !wide ? 'row-reverse' : 'row'}; flex-wrap: wrap; gap: 32px 56px; align-items: center; padding: 48px 0; border-bottom: 1px solid var(--line)`}>
          <div style={wide ? 'flex: 1 1 100%; min-width: 0' : 'flex: 1 1 480px; max-width: 620px; min-width: 0'}>
            {s.images.map((im) => {
              const img = <Image src={im.src} alt={im.alt} widths={[im.src.width]} sizes={wide ? '100vw' : '(min-width: 700px) 620px, 100vw'} style="display: block; width: 100%; height: auto; border-radius: 4px; margin-bottom: 8px" />;
              return im.full ? <a href={im.full}>{img}</a> : img;
            })}
          </div>
          <div style={wide ? 'flex: 1 1 100%; min-width: 0; max-width: 760px' : 'flex: 1 1 320px; min-width: 0'}>
            <h2 style="margin: 0 0 14px; font-family: var(--sans); font-weight: 800; font-size: 26px; line-height: 1.25" set:html={inline(s.heading)} />
            {s.paras.map((p) => <p style="margin: 0 0 14px" set:html={inline(p)} />)}
          </div>
        </section>
      );
    })}
    {closing.map((c) => <p style="margin: 0; padding: 28px 0 0; color: var(--muted); font-size: 17px" set:html={inline(c)} />)}
  </main>

  <section class="wrap" style="padding-top: 64px; padding-bottom: 80px">
    <h2 class="h-section" style="font-size: 28px; margin-bottom: 20px">More from the Khumbu</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; font-family: var(--sans)">
      {thumbs.map(({ p, first }) => (
        <a class="card" href={`/${p.id}/`} style="display: flex; gap: 16px; align-items: center; padding: 12px">
          {first && <Image src={first.src} alt="" width={96} height={96} style="width: 96px; height: 96px; object-fit: cover; border-radius: 4px; flex: none" />}
          <span><span style="display: block; font-weight: 700; font-size: 18px; line-height: 1.3">{p.data.title}</span><span class="meta">{imageCount(p.body)} photos</span></span>
        </a>
      ))}
    </div>
  </section>
</Base>
