{
  // Static Astro site on Cloudflare Workers static assets.
  // worker/index.js runs only for the paths in run_worker_first: "/" (old WordPress query URLs such as ?p=…),
  // /wp-includes/* (410 for the hacked site's doorway pages) and *.pagespeed.* (old mod_pagespeed file names).
  // All other paths are pure static assets, so they do not count against the Workers request limit.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ebc-astro",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-26",
  // Production runs only on the custom domain everestbasecamptrekguide.com.
  // workers.dev and per-version preview URLs are off so no copy of the site is public elsewhere.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "everestbasecamptrekguide.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/", "/wp-includes/*", "/*.pagespeed.*"]
  }
}
