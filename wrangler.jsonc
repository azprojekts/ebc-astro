{
  // Static Astro site on Cloudflare Workers static assets.
  // worker/index.js runs only for "/" to redirect old WordPress query URLs (?p=…); all other paths are pure assets.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ebc-astro",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-26",
  // Production runs only on the custom domain everestbasecamptrekguide.com.
  // workers.dev and per-version preview URLs are off so no copy of the site is public elsewhere.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/"]
  }
}
